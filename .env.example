DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NOTESFRAIS_COOKIE_SECRET=change-me-to-a-long-random-secret

# Comptes. Deux formes possibles.
#
# Recommandee : un tableau JSON, autant de comptes qu'on veut, mots de passe
# haches. Generer une empreinte avec :  node scripts/hash-password.mjs 'secret'
# NOTESFRAIS_USERS=[{"email":"mike@example.com","passwordHash":"scrypt$SEL$EMPREINTE","role":"user","app_channel":"mike"},{"email":"finance@example.com","passwordHash":"scrypt$SEL$EMPREINTE","role":"finance","app_channel":"all"}]
#
# Historique : deux comptes, mots de passe en clair. Ignoree si NOTESFRAIS_USERS
# est definie.
NOTESFRAIS_USER_EMAIL=mike@example.com
NOTESFRAIS_USER_PASSWORD=change-me
NOTESFRAIS_FINANCE_EMAIL=finance@example.com
NOTESFRAIS_FINANCE_PASSWORD=change-me
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=notesfrais-receipts
# Email. Deux transports possibles pour la soumission mensuelle, qui joint les
# justificatifs en ZIP : Gmail SMTP si GMAIL_SMTP_* est renseigne, sinon Resend.
# Gmail supporte de plus grosses pieces jointes.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
RESEND_API_KEY=

# Destinataire de la soumission mensuelle. OBLIGATOIRE : l'email part AVANT la
# cloture du mois, donc sans destinataire la soumission echoue entierement.
# MONTHLY_SUBMISSION_EMAIL a la priorite ; a defaut FINANCE_NOTIFICATION_EMAIL.
# Destinataire des soumissions du canal de preprod. Vide = meme boite que la
# production, mais l objet du mail est prefixe [PREPROD - ignorer].
MONTHLY_SUBMISSION_TEST_EMAIL=
MONTHLY_SUBMISSION_EMAIL=
FINANCE_NOTIFICATION_EMAIL=numeriqpayroll1@gmail.com
MONTHLY_SUBMISSION_FROM=

# Copie de chaque justificatif par email, a la creation du frais.
# Vide = envoyee a l'adresse du compte connecte.
RECEIPT_BACKUP_EMAIL=
RECEIPT_MAIL_FROM=NotesFrais <receipts@example.com>
SUBMISSION_MAIL_FROM=NotesFrais <onboarding@resend.dev>
